{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "cliui": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:codegen": "node ./playwright/scripts/codegen.js",
    "e2e:zip-report": "node ./playwright/scripts/zip-report.js",
    "e2e:full-report": "playwright test && node ./playwright/scripts/zip-report.js",
    "e2e:install": "playwright install --with-deps",
    "ci:install": "rm -r node_modules/.cache 2>/dev/null; npm ci"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1"
  }
}
